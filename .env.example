# Secrets and deployment values only. Rules and tuning live in chain.toml and each
# service's config.py.

INGOT_POSTGRES_USER=ingot
INGOT_POSTGRES_PASSWORD=
INGOT_POSTGRES_DB=ingot
INGOT_POSTGRES_HOST=127.0.0.1
INGOT_POSTGRES_PORT=5432

INGOT_NETUID=97
INGOT_NETWORK=finney
INGOT_START_BLOCK=0

INGOT_MODEL_CACHE_DIR=/var/lib/ingot/models
INGOT_DATASET_PATH=/var/lib/ingot/eval.jsonl
INGOT_EVAL_WORK_DIR=/var/lib/ingot/eval
INGOT_ARTIFACTS_DIR=/var/lib/ingot/artifacts
# Hugging Face downloads (genesis, teacher, kings); empty = HF_HOME / ~/.cache/huggingface
INGOT_HF_CACHE_DIR=/var/lib/ingot/hf
# per-request teacher/model hidden states; keep it on RAM (/dev/shm)
INGOT_HIDDEN_STATES_DIR=/dev/shm/ingot-hidden-states
HF_TOKEN=
INGOT_KING_HF_NAMESPACE=dendriteholdings

# the dedup bank (scripts/setup_opensearch.sh): no auth, published on localhost only
INGOT_OPENSEARCH_HOST=127.0.0.1
INGOT_OPENSEARCH_PORT=9270
INGOT_OPENSEARCH_INDEX=ingot_dedup
# at least 32 bytes; a new secret needs a freshly seeded bank (scripts/seed_dedup_bank.py)
INGOT_DEDUP_SECRET=
INGOT_DEDUP_DEVICE=cuda:0

# one vLLM server per listed GPU id. Teacher box: the teacher's GPUs (ingot-teacher-server).
# Eval box: the king's and the challenger's (whose GPUs also run the comparison); its teacher
# GPUs only without INGOT_TEACHER_URL, and then the three lists must not overlap
INGOT_TEACHER_GPUS=0,1,2,3
INGOT_KING_GPUS=0,1,2,3
INGOT_CHALLENGER_GPUS=4,5,6,7
# a teacher served by another box: on the eval box its url (the tunnel's local end, e.g.
# http://127.0.0.1:9300), empty to run it on INGOT_TEACHER_GPUS here; the serving box runs
# ingot-teacher-server on its INGOT_TEACHER_GPUS
INGOT_TEACHER_URL=http://127.0.0.1:9300
INGOT_TEACHER_PORT=9300

# pm2 tunnels: an ssh alias or user@host of each box, set where the tunnel runs
# (the central box for the db tunnels, the eval box for the teacher tunnel)
INGOT_PREEVAL_SSH=
INGOT_EVAL_SSH=

INGOT_WALLET_COLDKEY=
INGOT_WALLET_HOTKEY=
INGOT_WALLET_PATH=

R2_ACCOUNT_ID=
R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PRIVATE_MODELS_BUCKET_NAME=
R2_MAILBOX_BUCKET_NAME=ingot-mailbox-enam
R2_ARTIFACTS_BUCKET_NAME=ingot
R2_SITE_BUCKET_NAME=ingot-site
R2_MAILBOX_SIGNING_KEY=
